NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/petromate?replicaSet=rs0
CLIENT_ORIGIN=http://localhost:5173
SESSION_COOKIE_NAME=petromate_session
SESSION_ABSOLUTE_TTL_HOURS=720
SESSION_IDLE_TTL_HOURS=168
LOG_LEVEL=info

# One-time bootstrap command inputs
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_DISPLAY_NAME=Administrator
BOOTSTRAP_PASSWORD=replace-with-a-strong-password
BOOTSTRAP_TENANT_KEY=main-station
BOOTSTRAP_TENANT_NAME=Main Station
BOOTSTRAP_TIMEZONE=Asia/Manila
BOOTSTRAP_CURRENCY=PHP
BOOTSTRAP_EMPLOYEE_CODE=0001
