generator client {
  provider = "prisma-client-js"
  output   = "../src/db/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum TimesheetEntryAction {
  CHECK_IN
  CHECK_OUT
}

enum RateType {
  HOURLY
  DAILY
}

enum PayrollPeriodType {
  WEEKLY
}

enum NotificationType {
  PASSWORD_RESET_REQUEST
}

enum NotificationStatus {
  UNREAD
  READ
}

enum ReportStatus {
  DRAFT
  VALIDATED
  SUBMITTED
}

enum ProductCategory {
  FUEL
  STOCK_INVENTORY
}

enum ProductType {
  GASOLINE
  PREMIUM
  DIESEL
  KEROSENE
}

model User {
  id       String  @id @default(uuid())
  username String  @unique
  email    String? @unique
  name     String
  password String
  role     Role    @default(USER)

  birthday   DateTime?
  contact    String?
  address    String?
  position   String?
  sss        String?
  tin        String?
  philhealth String?
  pagibig    String?

  sessions        Session[]
  timesheets      Timesheet[]
  notifications   Notification[]
  createdReports  Report[]             @relation("ReportCreator")
  assignedReports EmployeesOnReports[]

  tenants     TenantsOnUsers[]
  salaryRates UserSalaryRate[]
  payrolls    Payroll[]

  shouldChangePassword Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Tenant {
  id          String  @id @default(uuid())
  name        String
  email       String
  contact     String
  address     String?
  description String?

  sss        String?
  tin        String?
  philhealth String?
  pagibig    String?

  logoUrl   String?
  documents Document[]

  users                TenantsOnUsers[]
  timesheets           Timesheet[]
  shifts               Shift[]
  products             Product[]
  reports              Report[]
  incomeAggregations   ReportIncomeAggregation[]
  expenseAggregations  ReportExpenseAggregation[]
  disposalAggregations ReportDisposalAggregation[]
  salaryRates          UserSalaryRate[]
  payrolls             Payroll[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TenantsOnUsers {
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String

  shift   Shift?  @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  shiftId String?

  @@id([userId, tenantId])
  @@index([shiftId])
}

model Shift {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name       String
  shiftStart DateTime
  shiftEnd   DateTime
  color      String

  users   TenantsOnUsers[]
  reports Report[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model Session {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Document {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name       String
  url        String
  uploadedAt DateTime @default(now())
}

model Timesheet {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  totalHours Float   @default(0)
  processed  Boolean @default(false)

  entries  TimesheetEntry[]
  payrolls PayrollTimesheet[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TimesheetEntry {
  id          String    @id @default(uuid())
  timesheetId String
  timesheet   Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)

  action    TimesheetEntryAction
  timestamp DateTime             @default(now())
}

model Notification {
  id     String             @id @default(uuid())
  type   NotificationType
  status NotificationStatus @default(UNREAD)

  metadata Json

  recipientId String
  recipient   User   @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([recipientId, status])
  @@index([recipientId, createdAt])
}

model Product {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name              String
  description       String?
  category          ProductCategory @default(FUEL)
  color             String          @default("grey")
  type              ProductType?
  active            Boolean         @default(true)
  lowStockThreshold Int?

  productPrices   ProductPrice[]
  productReadings ProductReading[]
  reportDisposals ReportDisposal[]
  inventory       Inventory?
  reportInventory ReportInventory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name, type])
  @@index([tenantId])
  @@index([tenantId, category])
  @@index([tenantId, type])
  @@index([tenantId, active])
}

model ProductPrice {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  price         Decimal  @db.Decimal(10, 2)
  effectiveFrom DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([productId, effectiveFrom])
}

model ProductReading {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  reading Decimal @db.Decimal(12, 3)

  createdAt DateTime @default(now())

  @@index([productId])
}

model Inventory {
  id        String  @id @default(uuid())
  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantity Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model ReportInventory {
  id        String  @id @default(uuid())
  reportId  String
  report    Report  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  quantity          Int
  unitPriceSnapshot Decimal @db.Decimal(10, 2)
  amount            Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([reportId, productId])
  @@index([reportId])
  @@index([productId])
}

model Report {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  creatorId String
  creator   User   @relation("ReportCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  shiftId String
  shift   Shift  @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  shiftDate DateTime
  status    ReportStatus @default(DRAFT)

  periodStart DateTime
  periodEnd   DateTime

  income      ReportIncome[]
  expenses    ReportExpense[]
  employees   EmployeesOnReports[]
  disposals   ReportDisposal[]
  inventories ReportInventory[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  submittedAt DateTime?

  @@unique([tenantId, shiftDate, shiftId, periodStart])
  @@index([tenantId, status])
  @@index([tenantId, shiftDate])
  @@index([tenantId, shiftDate, shiftId, periodStart])
  @@index([creatorId])
  @@index([shiftId])
}

model ReportExpense {
  id       String @id @default(uuid())
  reportId String
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  description String
  amount      Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([reportId])
}

model ReportIncome {
  id       String @id @default(uuid())
  reportId String
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  description String
  amount      Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([reportId])
}

model ReportDisposal {
  id       String @id @default(uuid())
  reportId String
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  beforeReading Decimal @db.Decimal(12, 3)
  afterReading  Decimal @db.Decimal(12, 3)
  netDisposal   Decimal @db.Decimal(12, 3)
  priceSnapshot Decimal @db.Decimal(10, 2)
  totalSales    Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([reportId, productId])
  @@index([reportId])
  @@index([productId])
}

model EmployeesOnReports {
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId String

  @@id([userId, reportId])
  @@index([reportId])
  @@index([userId])
}

model ReportIncomeAggregation {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  hourBucket  DateTime
  totalAmount Decimal  @db.Decimal(12, 2)
  incomeCount Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, hourBucket])
  @@index([tenantId, hourBucket])
}

model ReportExpenseAggregation {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  hourBucket   DateTime
  totalAmount  Decimal  @db.Decimal(12, 2)
  expenseCount Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, hourBucket])
  @@index([tenantId, hourBucket])
}

model ReportDisposalAggregation {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  hourBucket    DateTime
  productType   ProductType
  totalDisposal Decimal     @db.Decimal(12, 2)
  disposalCount Int         @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, hourBucket, productType])
  @@index([tenantId, hourBucket])
  @@index([tenantId, productType])
}

model UserSalaryRate {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  rate          Decimal  @db.Decimal(10, 2)
  rateType      RateType @default(DAILY)
  effectiveFrom DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([userId, tenantId, effectiveFrom])
  @@index([tenantId])
}

// NAMING ISSUE: This model should be called "Payslip" not "Payroll"
//
// Domain Terminology:
// - "Payroll" = The admin process of running payroll (generates multiple payslips for a period)
// - "Payslip" = Individual employee compensation record for a specific period
//
// This model represents a PAYSLIP because it:
// - Is specific to ONE user (userId field)
// - Represents compensation for ONE period (periodStart/periodEnd)
// - Contains individual compensation details (totalCompensation, rateSnapshot)
//
// What's missing:
// - A "PayrollRun" model to represent when an admin runs payroll
//   (would group multiple payslips created in a single admin action)
//
// TODO: Rename Payroll → Payslip
// TODO: Add 'notes' field (String?) to store admin notes about adjustments/overrides
//
model Payroll {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  periodType  PayrollPeriodType
  periodStart DateTime
  periodEnd   DateTime

  totalHours        Float    @default(0)
  rateSnapshot      Decimal  @db.Decimal(10, 2)
  rateTypeSnapshot  RateType
  totalCompensation Decimal  @db.Decimal(10, 2)

  timesheets PayrollTimesheet[]

  createdBy String
  createdAt DateTime @default(now())

  @@index([tenantId, userId])
  @@index([tenantId, periodStart, periodEnd])
  @@index([userId, periodStart])
}

// NAMING ISSUE: This should be called "PayslipTimesheet" not "PayrollTimesheet"
//
// Purpose:
// - Join table linking a Payslip (currently named Payroll) to its source Timesheets
// - Stores snapshot of hours and compensation at the time payroll was generated
// - Preserves audit trail of which timesheets contributed to each payslip
//
// Why the name is wrong:
// - "PayrollTimesheet" suggests it links the payroll process to timesheets
// - Actually links individual PAYSLIPS to their source timesheets
// - Should follow pattern: Payslip + Timesheet = PayslipTimesheet
//
// Fields:
// - hoursSnapshot: Total hours from this timesheet at time of payroll generation
// - compensationSnapshot: Compensation calculated for this timesheet (can be overridden)
//
// TODO: Rename PayrollTimesheet → PayslipTimesheet (when we rename Payroll → Payslip)
//
model PayrollTimesheet {
  payroll   Payroll @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  payrollId String

  timesheet   Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Restrict)
  timesheetId String

  hoursSnapshot        Float
  compensationSnapshot Decimal @db.Decimal(10, 2)

  @@id([payrollId, timesheetId])
  @@index([payrollId])
  @@index([timesheetId])
}
