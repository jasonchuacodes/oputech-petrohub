generator client {
  provider = "prisma-client-js"
  output   = "../src/db/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum TimesheetStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TimesheetEntryAction {
  CHECK_IN
  CHECK_OUT
}

enum NotificationType {
  PASSWORD_RESET_REQUEST
}

enum NotificationStatus {
  UNREAD
  READ
}

enum ReportStatus {
  DRAFT
  VALIDATED
  SUBMITTED
}

enum ProductCategory {
  FUEL
  STOCK_INVENTORY
}

model User {
  id       String  @id @default(uuid())
  username String  @unique
  email    String? @unique
  name     String
  password String
  role     Role    @default(USER)

  birthday   DateTime?
  contact    String?
  address    String?
  position   String?
  sss        String?
  tin        String?
  philhealth String?
  pagibig    String?

  sessions      Session[]
  timesheets    Timesheet[]
  notifications Notification[]
  createdReports  Report[]             @relation("ReportCreator")
  assignedReports EmployeesOnReports[]

  tenants TenantsOnUsers[]

  shouldChangePassword Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Tenant {
  id          String  @id @default(uuid())
  name        String
  email       String
  contact     String
  address     String?
  description String?

  sss        String?
  tin        String?
  philhealth String?
  pagibig    String?

  logoUrl   String?
  documents Document[]

  users      TenantsOnUsers[]
  timesheets Timesheet[]
  shifts     Shift[]
  products   Product[]
  reports    Report[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TenantsOnUsers {
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String

  shift   Shift?  @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  shiftId String?

  @@id([userId, tenantId])
  @@index([shiftId])
}

model Shift {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name       String
  shiftStart DateTime
  shiftEnd   DateTime
  color      String

  users    TenantsOnUsers[]
  reports  Report[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model Session {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Document {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name       String
  url        String
  uploadedAt DateTime @default(now())
}

model Timesheet {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  totalHours Float            @default(0)
  status     TimesheetStatus  @default(PENDING)
  entries    TimesheetEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TimesheetEntry {
  id          String    @id @default(uuid())
  timesheetId String
  timesheet   Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)

  action    TimesheetEntryAction
  timestamp DateTime             @default(now())
}

model Notification {
  id     String             @id @default(uuid())
  type   NotificationType
  status NotificationStatus @default(UNREAD)

  metadata Json

  recipientId String
  recipient   User   @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([recipientId, status])
  @@index([recipientId, createdAt])
}

model Product {
  id          String          @id @default(uuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  description String?
  category    ProductCategory @default(FUEL)

  productPrices        ProductPrice[]
  productReadings      ProductReading[]
  reportEntries        ReportEntry[]
  reportDisposals      ReportDisposal[]
  inventory            Inventory?
  reportInventory      ReportInventory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, category])
}

model ProductPrice {
  id            String   @id @default(uuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  price         Decimal  @db.Decimal(10, 2)
  effectiveFrom DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([productId, effectiveFrom])
}

model ProductReading {
  id            String   @id @default(uuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  reading       Decimal  @db.Decimal(12, 3)

  createdAt     DateTime  @default(now())

  @@index([productId])
}

model Inventory {
  id        String   @id @default(uuid())
  productId String   @unique
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantity  Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model ReportInventory {
  id                String   @id @default(uuid())
  reportId          String
  report            Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  quantity      Int
  unitPriceSnapshot Decimal  @db.Decimal(10, 2)
  totalPrice        Decimal  @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([reportId, productId])
  @@index([reportId])
  @@index([productId])
}

model Report {
  id          String        @id @default(uuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  creatorId   String
  creator     User          @relation("ReportCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  shiftId     String
  shift       Shift         @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  shiftDate   DateTime
  status      ReportStatus  @default(DRAFT)

  entries          ReportEntry[]
  income           ReportIncome[]
  expenses         ReportExpense[]
  employees        EmployeesOnReports[]
  disposals        ReportDisposal[]
  inventories      ReportInventory[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  submittedAt DateTime?

  @@unique([tenantId, shiftDate, shiftId])
  @@index([tenantId, status])
  @@index([tenantId, shiftDate])
  @@index([creatorId])
  @@index([shiftId])
}

model ReportEntry {
  id                String   @id @default(uuid())
  reportId          String
  report            Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  quantity          Decimal  @db.Decimal(10, 3)
  unitPriceSnapshot Decimal  @db.Decimal(10, 2)
  totalPrice        Decimal  @db.Decimal(10, 2)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([reportId, productId])
  @@index([reportId])
  @@index([productId])
}

model ReportExpense {
  id          String   @id @default(uuid())
  reportId    String
  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  description String
  amount      Decimal  @db.Decimal(10, 2)

  createdAt   DateTime @default(now())

  @@index([reportId])
}

model ReportIncome {
  id          String   @id @default(uuid())
  reportId    String
  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  description String
  amount      Decimal  @db.Decimal(10, 2)

  createdAt   DateTime @default(now())

  @@index([reportId])
}

model ReportDisposal {
  id            String   @id @default(uuid())
  reportId      String
  report        Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  beforeReading Decimal  @db.Decimal(12, 3)
  afterReading  Decimal  @db.Decimal(12, 3)
  netDisposal   Decimal  @db.Decimal(12, 3)
  priceSnapshot Decimal  @db.Decimal(10, 2)
  totalSales    Decimal  @db.Decimal(10, 2)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([reportId, productId])
  @@index([reportId])
  @@index([productId])
}

model EmployeesOnReports {
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String

  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId String

  @@id([userId, reportId])
  @@index([reportId])
  @@index([userId])
}
