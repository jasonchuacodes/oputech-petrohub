generator client {
  provider = "prisma-client-js"
  output   = "../src/db/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum TimesheetStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TimesheetEntryAction {
  CHECK_IN
  CHECK_OUT
}

enum NotificationType {
  PASSWORD_RESET_REQUEST
}

enum NotificationStatus {
  UNREAD
  READ
}

model User {
  id       String  @id @default(uuid())
  username String  @unique
  email    String? @unique
  name     String
  password String
  role     Role    @default(USER)

  birthday   DateTime?
  contact    String?
  address    String?
  position   String?
  sss        String?
  tin        String?
  philhealth String?
  pagibig    String?

  sessions      Session[]
  timesheets    Timesheet[]
  notifications Notification[]

  tenants TenantsOnUsers[]

  shouldChangePassword Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Tenant {
  id          String  @id @default(uuid())
  name        String
  email       String
  contact     String
  address     String?
  description String?

  sss        String?
  tin        String?
  philhealth String?
  pagibig    String?

  logoUrl   String?
  documents Document[]

  users      TenantsOnUsers[]
  timesheets Timesheet[]
  shifts     Shift[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TenantsOnUsers {
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId String

  shift   Shift?  @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  shiftId String?

  @@id([userId, tenantId])
  @@index([shiftId])
}

model Shift {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name       String
  shiftStart DateTime
  shiftEnd   DateTime

  users TenantsOnUsers[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model Session {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Document {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name       String
  url        String
  uploadedAt DateTime @default(now())
}

model Timesheet {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  totalHours Float            @default(0)
  status     TimesheetStatus  @default(PENDING)
  entries    TimesheetEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TimesheetEntry {
  id          String    @id @default(uuid())
  timesheetId String
  timesheet   Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)

  action    TimesheetEntryAction
  timestamp DateTime             @default(now())
}

model Notification {
  id     String             @id @default(uuid())
  type   NotificationType
  status NotificationStatus @default(UNREAD)

  metadata Json

  recipientId String
  recipient   User   @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([recipientId, status])
  @@index([recipientId, createdAt])
}
