{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm generate:graphql && pnpm --filter @petromate/server build"
  },
  "deploy": {
    "preDeployCommand": "pnpm --filter @petromate/server db:indexes",
    "startCommand": "pnpm --filter @petromate/server start:prod",
    "healthcheckPath": "/api/health/ready",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
